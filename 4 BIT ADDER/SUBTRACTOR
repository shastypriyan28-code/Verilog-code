4 BIT ADDER/SUBTRACTOR module Add_Sub(a, b, m, c);
input [3:0] a, b;
input m;
output reg [4:0] c;
always @(a, b, m)
begin if(m == 0) 
  c = a + b;
  else 
  c = a - b;
end endmodule
